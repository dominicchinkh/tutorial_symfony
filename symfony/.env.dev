# Overrides env vars only for one environment but for all machines (these files are committed)

# In all environments, the following files are loaded if they exist, the latter taking precedence:
#
#  * .env                contains default values for the environment variables
#  * .env.local          uncommitted file with local overrides
#  * .env.$APP_ENV       committed file with defaults for a specific environment
#  * .env.$APP_ENV.local uncommitted file with local overrides for a specific environment
#
# Note: Real environment variables always win over env vars created by any of the .env files
#
# The variables values are exposed as environment variables during the execution of the app

###> symfony/framework-bundle ###
APP_ENV=dev
APP_SECRET=a1b2c3d4e5f6a1b2c3d4e5f6
###< symfony/framework-bundle ###

###> doctrine/doctrine-bundle ###
# Format described at https://www.doctrine-project.org/projects/doctrine-dbal/en/latest/reference/configuration.html#connecting-using-a-url
# IMPORTANT: You MUST configure your server version, either here or in config/packages/doctrine.yaml
#
DATABASE_URL="sqlite:///%kernel.project_dir%/var/data.db"
###< doctrine/doctrine-bundle ###
