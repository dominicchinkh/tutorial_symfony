# Define machine-specific env var overrides only for one environment. It's similar to .env.local, 
# but the overrides only apply to one environment

# In all environments, the following files are loaded if they exist, the latter taking precedence:
#
#  * .env                contains default values for the environment variables
#  * .env.local          uncommitted file with local overrides
#  * .env.$APP_ENV       committed file with defaults for a specific environment
#  * .env.$APP_ENV.local uncommitted file with local overrides for a specific environment
#
# The variables values are exposed as environment variables during the execution of the app.

###> symfony/framework-bundle ###
APP_SECRET=a1b2c3d4e5f6a1b2c3d4e5f6
