{% extends 'template/layout.html.twig' %}

{% block stylesheets %}
    {# the CSS file lives at "public/css/blog.css" #}
    <link href="{{ asset('css/blog.css') }}" rel="stylesheet">
{% endblock %}

{% block page_contents %}

    {# the image lives at "public/images/logo.png" #}
    <div>
        <img src="{{ asset('images/logo.jpg') }}" alt="">
    </div>

    <div>
        <a href="{{ path('template-blog') }}">Homepage</a>
    </div>
    
    {#
        Use the path() Twig function to link to these pages and pass the route name as the first 
        argument and the route parameters as the optional second argument
    #}
    <div>
        <h3>Relative URL</h3>
        {% for post in blog_posts %}
            <h4>
                <a href="{{ path('template-article', {slug: post.slug}) }}">{{ post.title }}</a>
            </h4>

            <p>{{ post.excerpt }}</p>
        {% endfor %}
    </div>

    {#
        If you need to generate absolute URLs (for example when rendering templates for emails or 
        RSS feeds), use the absolute_url()/url() function, which takes the same arguments as path()
    #}
    <div>
        <h3>Absolute URL</h3>
        {% for post in blog_posts %}
            <h4>
                <a href="{{ url('template-article', {slug: post.slug}) }}">{{ post.title }}</a>
            </h4>

            <p>{{ post.excerpt }}</p>
        {% endfor %}
    </div>

    {#
        For most "reusable UI unit" needs (like the recent-articles example below), prefer 
        Twig Components
    #}
    <div id="sidebar">
        <h3>Embedding controllers</h3>
        {# 
            if the controller is associated with a route, use the path() or url() functions 

                {{ render(path('latest_articles', {max: 3})) }}
                {{ render(url('latest_articles', {max: 3})) }}
        #}

        {# 
            if you don't want to expose the controller with a public URL, use the controller() 
            function to define the controller to execute 
        #}
        {{ render(controller(
            'App\\Controller\\TemplateController::recentArticles', {max: 3}
        )) }}
    </div>

{% endblock %}

{% block javascript %}
    {# the JS file lives at "public/js/loader.js" #}
    <script src="{{ asset('js/loader.js') }}"></script>
{% endblock %}
